{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/admin/quizzes/[id]",
      "regex": "^/admin/quizzes/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/admin/quizzes/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/admin/categories/[id]",
      "regex": "^/api/admin/categories/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/admin/categories/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/admin/quizzes/[id]",
      "regex": "^/api/admin/quizzes/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/admin/quizzes/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/admin/vocabularies/[id]",
      "regex": "^/api/admin/vocabularies/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/admin/vocabularies/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/auth/[...nextauth]",
      "regex": "^/api/auth/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPnextauth": "nxtPnextauth"
      },
      "namedRegex": "^/api/auth/(?<nxtPnextauth>.+?)(?:/)?$"
    },
    {
      "page": "/learning/[slug]",
      "regex": "^/learning/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/learning/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/learning/[slug]/flashcards",
      "regex": "^/learning/([^/]+?)/flashcards(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/learning/(?<nxtPslug>[^/]+?)/flashcards(?:/)?$"
    },
    {
      "page": "/learning/[slug]/quiz",
      "regex": "^/learning/([^/]+?)/quiz(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/learning/(?<nxtPslug>[^/]+?)/quiz(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/admin",
      "regex": "^/admin(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin(?:/)?$"
    },
    {
      "page": "/admin/ai-hub",
      "regex": "^/admin/ai\\-hub(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/ai\\-hub(?:/)?$"
    },
    {
      "page": "/admin/ai-hub/quizzes",
