      "static/chunks/main-app.js",
      "static/chunks/app/learning/[slug]/quiz/page.js"
    ],
    "/api/quizzes/route": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/api/quizzes/route.js"
    ],
    "/admin/layout": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/admin/layout.js"
    ],
    "/admin/quizzes/[id]/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/admin/quizzes/[id]/page.js"
    ],
    "/api/admin/quizzes/[id]/route": [
      "static/chunks/webpack.js",
